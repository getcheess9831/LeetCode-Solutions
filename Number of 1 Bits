class Solution(object):
    def hammingWeight(self, n):
        result = 0
        while n != 0:
            n = n & (n-1)
            result += 1
        
        return result



    
    #loop while n not = 0, using n & (n-1) to remove the right most 1, and add 1 to the result. we can also convert n to binary string, and count how many 1's using for loop, but it will always loop through the whole string while bit manipulation will only run the result number of times.
    #Time complexity technically O(1) as the max times of loop is 32.
    #Space complexity is also O(1) with a variable result always less than or equal to 32.
        

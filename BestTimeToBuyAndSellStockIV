class Solution(object):
    def maxProfit(self, k, prices):
        """
        :type k: int
        :type prices: List[int]
        :rtype: int
        """
        if k >= len(prices)//2:
            result = 0
            for i in range(0, len(prices) - 1):
                if prices[i+1] - prices[i] > 0:
                    result += prices[i+1] - prices[i]
        
            return result

        else:
            buy = [-float('inf')] * k
            sell = [0] * k
            for i in range(0, len(prices)): 
                for j in range(0, k): 
                    if j == 0:       
                        buy[j] = max(buy[j], 0 - prices[i])
                    else:
                        buy[j]  = max(buy[j], sell[j-1] - prices[i])

                    sell[j] = max(sell[j], buy[j] + prices[i]) 
        
        
            return sell[k-1]
    

#The question asks to find the max profit you can achieve with at most k transactions.(buying/selling at most k times.)
#The problem is very similar to question 123 Best Time to Buy and Sell Stock III, the difference is that you don't have a fixed number of transactions. However, we use the same idea to solve this problem. We have a list buy and sell representing on j^th buy/sell, the max profit we can hold. 
#Tciky part about this question is that when k >= n//2, we can use greedy algorithm to solve this question, because each profitable transaction requires at least 2 days (1 buy + 1 sell), so the greedy algorithm can never make more than n//2 transactions regardless of k.
#The time complexity for this question is O(n*k) where n is the size of prices and k stands for the number of transactions. It can also be O(n) when k >= n//2, which is just greedy algorithm.
#The space complexity for this question is O(k), where k is the number of transactions, the size of buy and sell is initiated with the number k. Or O(1) when we can use greedy algorithm to solve the problem.

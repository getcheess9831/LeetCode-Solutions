class Solution(object):
    def maxProfit(self, prices):
        """
        :type prices: List[int]
        :rtype: int
        """
        first_buy   = -prices[0]      
        first_sell  = 0
        second_buy  = -float('inf')   
        second_sell = 0
        for i in range(1, len(prices)):
            
            first_buy   = max(first_buy,   -prices[i])  
            first_sell  = max(first_sell,  first_buy + prices[i])   
            second_buy  = max(second_buy,  first_sell - prices[i])   
            second_sell = max(second_sell, second_buy + prices[i])   


        

        

        return second_sell

#The problem asks to find the max profit you can achieve, with the condition of at most two transactions.
#We can solve the problem using DP, we will have 5 status, no transaction, first buy, first sell, second buy, second sell, each representing the profit of the action. No transaction is always 0 so we can ignore that. The tricky part for this question is, when you look at all four status and their update conditions, they rely on eachother, we would instinctly think that what's relied should be updated after the reliance. But the problem did not say that you cannot do multiple actions in one day, so it is actually wrong to update them based on reliance.
#The time complexity for this method is O(n), one iteration through the array prices, where n stands for length of prices.
#The space complexity for this method is O(1), only 4 variables with fixed size of 1 are used.
